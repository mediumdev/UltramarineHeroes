  _stagename: "\u062A\u0646\u06AF\u0647 \u0628\u0631\u0648\u062A\u0644\u0627\u062E"
  _description: "\u0628\u0631\u0648\u062A\u0644\u0627\u062E\u060C \u062E\u0627\u0644\u0642
    \u0642\u0644\u0645\u0631\u0648\u06CC \u0632\u06CC\u0631\u0632\u0645\u06CC\u0646\u06CC
    \u0628\u0631\u0627\u06CC \u0627\u062D\u06CC\u0627\u06CC \u0642\u062F\u0631\u062A
    \u062E\u0648\u062F \u0648 \u0627\u0633\u062A\u0631\u0627\u062D\u062A \u0627\u063A\u0644\u0628
    \u0627\u0632 \u0627\u06CC\u0646 \u062A\u0646\u06AF\u0647 \u062F\u06CC\u062F\u0646
    \u0645\u06CC\u06A9\u0631\u062F. \u0627\u0648 \u0642\u0628\u0644 \u0627\u0632
    \u0645\u0631\u06AF \u0648 \u062A\u0628\u062F\u06CC\u0644 \u0634\u062F\u0646 \u0628\u0647
    \u0622\u062A\u0634\u060C \u0639\u0635\u0627\u06CC \u062E\u0634\u0645 \u062E\u0648\u062F
    \u0631\u0627 \u062F\u0631 \u062A\u0646\u06AF\u0647 \u067E\u0646\u0647\u0627\u0646
    \u06A9\u0631\u062F. \u0686\u0646\u062F \u062C\u0627\u062F\u0648\u06AF\u0631 \u0622\u0646
    \u0639\u0635\u0627\u0631 \u0631\u0627 \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062F\u0646\u062F\u060C
    \u0627\u0645\u0627 \u0642\u062F\u0631\u062A \u0622\u0646 \u0686\u0646\u0627\u0646
    \u0628\u0627\u0648\u0631\u0646\u06A9\u0631\u062F\u0646\u06CC \u0648 \u062E\u0637\u0631\u0646\u0627\u06A9
    \u0628\u0648\u062F \u06A9\u0647\u062A\u0635\u0645\u06CC\u0645 \u06AF\u0631\u0641\u062A\u0646\u062F
    \u0645\u06A9\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0647\u0645\u06AF\u0627\u0646
    \u0645\u062E\u0641\u06CC \u0646\u06AF\u0647 \u062F\u0627\u0631\u0646\u062F."
