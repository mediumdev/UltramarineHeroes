  _stagename: "\u063A\u0627\u0631 \u0627\u0634\u0628\u0627\u062D"
  _description: "\u0634\u0645\u0634\u06CC\u0631 \u062D\u0642\u06CC\u0642\u062A \u0628\u06A9\u0631
    \u0642\u062F\u0631\u062A\u0645\u0646\u062F\u062A\u0631\u06CC\u0646 \u062C\u0646\u06AF
    \u0627\u0641\u0632\u0627\u0631 \u062F\u0631 \u0627\u06CC\u0627\u0633 \u0627\u0633\u062A
    \u06A9\u0647 \u062D\u062A\u06CC \u0642\u0628\u0644 \u0627\u0632 \u062A\u0648\u0644\u062F
    \u0628\u0631\u0648\u062A\u0627\u0644\u0627\u062E\u060C \u0628\u06CC\u062A\u0648
    \u0648 \u0646\u0648\u0644\u0627 \u062E\u0644\u0642 \u0634\u062F\u0647 \u0627\u0633\u062A.
    \u062A\u0646\u0647\u0627 \u06A9\u0633\u0627\u0646\u06CC \u06A9\u0647 \u0635\u0627\u062F\u0642\u0627\u0646\u0647
    \u0628\u0627 \u0634\u0631 \u0645\u0628\u0627\u0631\u0632\u0647 \u0645\u06CC\u06A9\u0646\u0646\u062F
    \u0645\u06CC\u062A\u0648\u0627\u0646\u0646\u062F \u0622\u0646 \u0631\u0627 \u062F\u0631
    \u063A\u0627\u0631\u0647\u0627\u06CC \u0639\u0645\u06CC\u0642 \u0628\u06CC\u0627\u0628\u0646\u062F
    \u0648 \u0627\u0632 \u0642\u062F\u0631\u062A \u0622\u0646 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
    \u06A9\u0646\u0646\u062F."
