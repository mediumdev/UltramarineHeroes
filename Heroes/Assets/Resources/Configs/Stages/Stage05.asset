  _stagename: "\u0628\u06CC\u0634\u0647 \u0639\u0631\u0641\u0627\u0646\u06CC"
  _description: "\u062C\u0646\u06AF\u0644\u06CC \u062C\u0627\u062F\u0648\u06CC\u06CC
    \u06A9\u0647 \u0638\u0627\u0647\u0631\u0634 \u0645\u0637\u0627\u0628\u0642 \u0628\u0627
    \u0648\u0636\u0639\u06CC\u062A \u062F\u0631 \u062C\u0647\u0627\u0646 \u0627\u06CC\u0627\u0633
    \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u06A9\u0646\u062F. \u0628\u0631\u0627\u06CC
    \u0642\u0631\u0646\u0647\u0627\u06CC \u0645\u062A\u0645\u0627\u062F\u06CC\u060C
    \u0628\u06CC\u0634\u0647 \u0639\u0631\u0641\u0627\u0646\u06CC \u0645\u06A9\u0627\u0646\u06CC
    \u062F\u0631\u062E\u0634\u0627\u0646 \u0648 \u0632\u06CC\u0628\u0627 \u067E\u0631
    \u0627\u0632 \u062D\u06CC\u0648\u0627\u0646\u0627\u062A \u0648 \u067E\u0631\u0646\u062F\u06AF\u0627\u0646
    \u0628\u0648\u062F\u0647\u060C \u0627\u0645\u0627 \u067E\u0633 \u0627\u0632 \u062D\u0645\u0644\u0647
    \u0641\u0644\u06CC\u0646 \u0628\u0647 \u0627\u06CC\u0627\u0633\u060C \u062A\u0627\u0631\u06CC\u06A9\u06CC
    \u0648 \u062A\u06CC\u0631\u06AF\u06CC \u0628\u0631 \u0627\u06CC\u0646 \u0628\u06CC\u0634\u0647
    \u0645\u0633\u062A\u0648\u0644\u06CC \u0634\u062F."
