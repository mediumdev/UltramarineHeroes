  _stagename: "\u062C\u0646\u06AF\u0644 \u0627\u0631\u0648\u0627\u062D"
  _description: "\u0641\u0644\u06CC\u0646 \u067E\u0633 \u0627\u0632 \u062C\u0645\u0639
    \u0622\u0648\u0631\u06CC \u0627\u0631\u062A\u0634 \u06A9\u0648\u0686\u06A9\u06CC
    \u0645\u062A\u0634\u06A9\u0644 \u0627\u0632 \u0627\u0648\u0631\u06A9 \u0648 \u0627\u0646\u0633\u0627\u0646\u060C
    \u0628\u0647 \u0627\u0639\u0645\u0627\u0642 \u062C\u0646\u06AF\u0644 \u0627\u0631\u0648\u0627\u062D
    \u0631\u0641\u062A \u06A9\u0647 \u0645\u06A9\u0627\u0646\u06CC \u0645\u0642\u062F\u0633
    \u0628\u0631\u0627\u06CC \u0633\u0627\u06A9\u0646\u0627\u0646 \u0642\u0644\u0645\u0631\u0648\u06CC
    \u0632\u0645\u06CC\u0646 \u0627\u0633\u062A. \u0647\u0646\u0648\u0632 \u0647\u0645
    \u0645\u06CC\u0634\u0647 \u062C\u0627\u0647 \u0637\u0644\u0628\u06CC \u0647\u0627\u06CC
    \u067E\u0644\u06CC\u062F \u0641\u0644\u06CC\u0646 \u0631\u0648 \u062F\u0631 \u0646\u0637\u0641\u0647
    \u062E\u0641\u0647 \u06A9\u0631\u062F \u0648 \u062E\u0627\u0626\u0646\u0627\u0646
    \u0631\u0648 \u0634\u06A9\u0633\u062A \u062F\u0627\u062F."
