  _stagename: "\u06A9\u0648\u0647 \u0646\u0648\u0644\u0627 "
  _description: "\u067E\u0633 \u0627\u0632 \u0627\u06CC\u0646\u06A9\u0647 \u0627\u0644\u0647\u0647
    \u0646\u0648\u0644\u0627 \u0642\u0644\u0645\u0631\u0648\u06CC \u0622\u0633\u0645\u0627\u0646
    \u0631\u0627 \u0627\u06CC\u062C\u0627\u062F \u06A9\u0631\u062F\u060C \u06A9\u0631\u06CC\u0633\u062A\u0627\u0644
    \u062C\u0627\u0648\u062F\u0627\u0646\u06AF\u06CC \u0631\u0627 \u0648\u0642\u0641
    \u0622\u0646 \u0646\u0645\u0648\u062F\u060C \u0645\u062D\u0635\u0648\u0644\u06CC
    \u06A9\u0647 \u0628\u0647 \u0633\u0627\u06A9\u0646\u0627\u0646 \u0622\u0646 \u0642\u0644\u0645\u0631\u0648
    \u06A9\u0645\u06A9 \u06A9\u0631\u062F \u0639\u0645\u0631 \u0637\u0648\u0644\u0627\u0646\u06CC
    \u062A\u0631 \u0648 \u0628\u062F\u0648\u0646 \u0628\u06CC\u0645\u0627\u0631\u06CC
    \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F. \u0639\u0635\u0627\u06CC
    \u062E\u0634\u0645\u060C \u06A9\u062A\u0627\u0628 \u0637\u0644\u0633\u0645 \u0648
    \u06A9\u0631\u06CC\u0633\u062A\u0627\u0644 \u062C\u0627\u0648\u062F\u0627\u0646\u06AF\u06CC
    \u0645\u06CC\u062A\u0648\u0627\u0646\u0646\u062F \u0628\u0647 \u06CC\u06A9 \u0645\u062D\u0635\u0648\u0644
    \u0642\u062F\u0631\u062A\u0645\u0646\u062F \u062A\u0628\u062F\u06CC\u0644 \u0634\u0648\u0646\u062F
    \u06A9\u0647 \u0628\u0647 \u0635\u0627\u062D\u0628\u0634 \u0642\u062F\u0631\u062A
    \u062A\u0642\u0631\u06CC\u0628\u0627 \u0646\u0627\u0645\u062D\u062F\u0648\u062F\u06CC
    \u062F\u0631 \u0646\u0628\u0631\u062F \u0645\u06CC\u062F\u0647\u062F."
