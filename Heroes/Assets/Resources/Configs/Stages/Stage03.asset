  _stagename: "\u062F\u0631\u0647 \u0628\u06CC\u062A\u0648"
  _description: "\u0622\u0632\u0627\u062F\u06CC \u0648 \u0648\u0633\u0639\u062A \u0627\u06CC\u0646
    \u062F\u0631\u0647\u060C \u0628\u06CC\u062A\u0648 \u062E\u0627\u0644\u0642 \u0642\u0644\u0645\u0631\u0648\u06CC
    \u0632\u0645\u06CC\u0646 \u0631\u0627 \u0628\u0647 \u062E\u0648\u062F \u062C\u0630\u0628
    \u06A9\u0631\u062F\u0647. \u0627\u06CC\u0646 \u062F\u0631\u0647 \u0631\u0627\u0647
    \u0631\u0627 \u0628\u0631\u0627\u06CC \u0645\u0639\u062C\u0632\u0627\u062A \u0648
    \u0686\u0634\u0645 \u0627\u0646\u062F\u0627\u0632\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631
    \u0642\u0644\u0645\u0631\u0648 \u0628\u0627\u0632 \u06A9\u0631\u062F \u06A9\u0647
    \u0628\u06CC\u062A\u0648 \u0628\u0627 \u06A9\u0645\u06A9 \u06A9\u062A\u0627\u0628
    \u0637\u0644\u0633\u0645 \u062E\u0648\u062F \u0627\u06CC\u062C\u0627\u062F \u06A9\u0631\u062F
    \u06A9\u0647 \u0627\u06A9\u0646\u0648\u0646 \u062A\u062D\u062A \u062D\u0645\u0627\u06CC\u062A
    \u0644\u0631\u062F \u0644\u06CC\u0686 \u067E\u0646\u0647\u0627\u0646 \u0634\u062F\u0647
    \u0627\u0633\u062A."
