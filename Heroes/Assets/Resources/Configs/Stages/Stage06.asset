  _stagename: "\u062F\u0631\u06CC\u0627\u0686\u0647 \u06AF\u0644\u06CC\u0646"
  _description: "\u0633\u0637\u062D \u0635\u0627\u0641 \u0648 \u0622\u06CC\u0646\u0647
    \u0627\u06CC \u062F\u0631\u06CC\u0627\u0686\u0647 \u0648 \u0622\u0628 \u0633\u0631\u062F
    \u0622\u0646\u060C \u062F\u0648\u0631\u0641 \u0647\u0627 \u0631\u0627 \u0628\u0647
    \u062E\u0648\u062F \u062C\u0630\u0628 \u06A9\u0631\u062F \u0648 \u0622\u0646\u0647\u0627
    \u062F\u0631 \u0627\u0637\u0631\u0627\u0641 \u0622\u0646 \u0633\u0627\u06A9\u0646
    \u0634\u062F\u0646\u062F \u0648 \u0633\u0644\u0627\u062D\u060C \u0632\u0631\u0647
    \u0648 \u0648\u0633\u0627\u06CC\u0644 \u0641\u0644\u0632\u06CC \u0628\u0631\u0627\u06CC
    \u062E\u0648\u062F \u0633\u0627\u062E\u062A\u0646\u062F. \u0628\u0639\u0636\u06CC
    \u0627\u0632 \u062F\u0648\u0631\u0641 \u0647\u0627 \u062A\u0627 \u0648\u0633\u0637
    \u062F\u0631\u06CC\u0627\u0686\u0647 \u0634\u0646\u0627 \u06A9\u0631\u062F\u0646\u062F
    \u0648 \u062F\u0631 \u0622\u0646\u062C\u0627 \u062C\u0632\u06CC\u0631\u0647 \u0627\u06CC
    \u06A9\u0648\u0686\u06A9 \u0628\u0627 \u0645\u0639\u0628\u062F\u06CC \u0645\u0631\u0645\u0648\u0632
    \u06CC\u0627\u0641\u062A\u0646\u062F."
