  _description: "\u0645\u0639\u0628\u062F\u06CC \u0628\u0627 \u067E\u06CC\u0634\u06AF\u0648\u06CC\u06CC
    \u0627\u0641\u0633\u0627\u0646\u0647 \u0627\u06CC \u062F\u0631 \u0645\u0648\u0631\u062F
    \u0622\u06CC\u0646\u062F\u0647 \u0627\u06CC\u0627\u0633 \u062F\u0631 \u062C\u0632\u06CC\u0631\u0647
    \u0634\u062C\u0627\u0639\u062A \u0648\u0627\u0642\u0639 \u0634\u062F\u0647 \u0627\u0633\u062A.
    \u0628\u0633\u06CC\u0627\u0631\u06CC \u0627\u0632 \u0642\u0647\u0631\u0645\u0627\u0646\u0627\u0646
    \u0628\u0647 \u0645\u0639\u0628\u062F \u0631\u0633\u06CC\u062F\u0646\u062F\u060C
    \u0627\u0645\u0627 \u0647\u0646\u0648\u0632 \u06A9\u0633\u06CC \u0645\u0648\u0641\u0642
    \u0628\u0647 \u062E\u0648\u0627\u0646\u062F\u0646 \u067E\u06CC\u0634\u06AF\u0648\u06CC\u06CC
    \u0646\u0634\u062F\u0647."
